{
  "name": "config-drift-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @config-drift-guard/api --filter @config-drift-guard/web dev",
    "demo": "DEMO_MODE=1 QUEUE_DELAY_MS=2000 PHASE_DELAY_MS=500 corepack pnpm dev",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm typecheck:e2e && corepack pnpm build && corepack pnpm test && corepack pnpm test:admission",
    "test:admission": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_main_ruleset_admission.py'",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
